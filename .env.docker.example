# Copy to .env (next to docker-compose.yml) and edit. Used only by `docker compose`.

# ─── Ports & URLs ──────────────────────────────────────────
# Port the app is published on (http://<server>:APP_PORT).
APP_PORT=8080
# The exact address people open in the browser (used for CORS and links in emails).
# Examples: http://localhost:8080 · http://203.0.113.10:8080 · https://app.example.com
PUBLIC_APP_URL=http://localhost:8080
# true only when the app is served over https://. Keep false for plain http, or login won't stick.
COOKIE_SECURE=false

# ─── Database (created automatically in the db container) ──
POSTGRES_USER=estatepilot
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=estatepilot

# ─── Auth & Initial Admin ─────────────────────────────────
# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@leadstrellis.com"
ADMIN_PASSWORD="change-me-admin-password"

# ─── AI (Groq) ─────────────────────────────────────────────
# Blank key = rule-based fallback, everything still works.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b

# ─── Email (proposals + replies) ───────────────────────────
# Blank SMTP_HOST = emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=60
ADMIN_BRIEFING_TO=
APP_NAME="LeadsTrellis"

# ─── Automation timing ─────────────────────────────────────
NO_REPLY_HOURS=48
MAX_CONTACT_ATTEMPTS=3
SCHEDULER_INTERVAL_SECONDS=60
JOB_SPACING_MS=1500

# ─── Twilio / ElevenLabs (optional, not used in Phase 2) ───
CALL_PROVIDER=simulated
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_TO_NUMBER=
TWILIO_WHATSAPP_FROM=
ELEVENLABS_API_KEY=
