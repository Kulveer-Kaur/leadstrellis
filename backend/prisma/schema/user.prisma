model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  phone           String?
  avatarUrl       String?
  isActive        Boolean   @default(true)
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  leads    Lead[]
  viewings Viewing[]
}
