# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public HTTPS URL that reaches this server (needed for Twilio webhooks), e.g. an ngrok URL.
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ─── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estatepilot?schema=public
DATABASE_POOL_MAX=10

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── AI (Groq, free tier) ──────────────────────────────────
# LLM_PROVIDER=groq uses Groq; LLM_PROVIDER=mock runs fully offline with deterministic output.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Fast model: lead understanding, message drafts, call summaries.
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Smart model: property re-ranking and the live call agent.
GROQ_MODEL_SMART=openai/gpt-oss-120b

# ─── Voice calls (Twilio) ──────────────────────────────────
# CALL_PROVIDER=twilio places real calls; CALL_PROVIDER=simulated uses the in-app text call.
CALL_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number that places the calls (E.164, e.g. +15005550006).
TWILIO_FROM_NUMBER=
# SAFETY: outside production every real call / SMS / WhatsApp goes to this verified number,
# never to the (dummy) lead's phone. Trial accounts can only call verified numbers anyway.
TWILIO_TEST_TO_NUMBER=
# Optional: Twilio WhatsApp sender (sandbox: whatsapp:+14155238886). Empty = mock WhatsApp.
TWILIO_WHATSAPP_FROM=
# Voice used by Twilio <Say> when ElevenLabs is not configured.
TWILIO_SAY_VOICE=Polly.Joanna
VOICE_LANGUAGE=en-US

# ─── Text to speech (ElevenLabs, optional) ─────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ─── Automation timing ─────────────────────────────────────
# Hours without a reply before the AI retries on the next channel (use 0.05 for a quick demo).
NO_REPLY_HOURS=48
MAX_CONTACT_ATTEMPTS=3
SCHEDULER_INTERVAL_SECONDS=60
# Pause between AI pipeline jobs, to stay inside Groq free-tier token limits.
JOB_SPACING_MS=1500

# ─── Email (proposals + replies) ───────────────────────────
# SMTP sends proposals; Gmail needs an app password. Leave blank to log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Frontend URL used in email links (proposal page).
PUBLIC_APP_URL=http://localhost:5173
# Optional: API URL for the PDF link in emails (default: PUBLIC_APP_URL/api/v1).
PUBLIC_API_URL=
# IMAP reads lead replies. Blank = reuse the SMTP account (smtp.gmail.com → imap.gmail.com).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_POLL_SECONDS=60

# Optional, only for `npm run images:fetch` (seed listing photos). Free key: https://www.pexels.com/api/
PEXELS_API_KEY=
